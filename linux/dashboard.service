[Unit]
Description=Dashboard web del sistema di trading
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/trading
# Senza questo, print() finisce in un buffer da 8 KB che con un servizio
# di lunga durata non viene quasi mai scaricato: le diagnostiche non
# arrivano MAI nel journal, e a un riavvio si perdono del tutto.
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /home/%i/trading/dashboard.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
