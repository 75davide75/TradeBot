[Unit]
Description=Trading bot paper — segnali Telegram
After=network-online.target
Wants=network-online.target

# Se il bot si blocca all'avvio perche' lo stato e' sparito, riprovare
# all'infinito non serve: il problema non si risolve da solo. Dopo tre
# tentativi systemd lascia il servizio in stato "failed", che healthcheck.py
# vede e segnala nel messaggio del mattino.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/trading
# Senza questo, print() finisce in un buffer da 8 KB che con un servizio
# di lunga durata non viene quasi mai scaricato: le diagnostiche non
# arrivano MAI nel journal, e a un riavvio si perdono del tutto.
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /home/%i/trading/bot.py

Restart=always
RestartSec=30

# I log vanno a journald, non su file: niente crescita infinita
# e niente usura inutile della SD. Si leggono con:
#   journalctl -u tradingbot -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
