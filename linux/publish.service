[Unit]
Description=Pubblica i dati della dashboard su GitHub Pages
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/home/%i/trading
# Senza questo, print() finisce in un buffer da 8 KB che con un servizio
# di lunga durata non viene quasi mai scaricato: le diagnostiche non
# arrivano MAI nel journal, e a un riavvio si perdono del tutto.
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /home/%i/trading/publish.py
StandardOutput=journal
StandardError=journal
